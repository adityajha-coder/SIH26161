{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "description": "Standard dam-break and river blockage scenario definition contract for SIH26161 (STRATA)",
  "type": "object",
  "required": [
    "scenario_id",
    "case_id",
    "trigger_type",
    "breach_parameters",
    "initial_conditions",
    "solver_selection"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "description": "Unique scenario identifier (e.g., scen-tehri-dam-1695781200)"
    },
    "case_id": {
      "type": "string",
      "enum": ["tehri-dam", "sardar-sarovar-dam", "bhakra-dam", "idukki-dam"],
      "description": "Identifier of the target case study"
    },
    "name": {
      "type": "string",
      "description": "Human-readable label for the scenario"
    },
    "description": {
      "type": "string",
      "description": "Technical context or failure mode description"
    },
    "trigger_type": {
      "type": "string",
      "enum": ["overtopping", "piping", "seismic", "landslide_blockage", "controlled_release"],
      "description": "Initiating dam failure or blockage mechanism"
    },
    "dem_version": {
      "type": "string",
      "default": "copernicus-glo30-utm44n-v1",
      "description": "Registered DEM dataset reference"
    },
    "breach_parameters": {
      "type": "object",
      "required": [
        "formation_time_hr",
        "final_width_m",
        "final_depth_m",
        "side_slope_h_v"
      ],
      "properties": {
        "formation_time_hr": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 24.0,
          "description": "Breach development time in hours (tf)"
        },
        "final_width_m": {
          "type": "number",
          "minimum": 5.0,
          "maximum": 600.0,
          "description": "Average breach width in metres (Bavg)"
        },
        "final_depth_m": {
          "type": "number",
          "minimum": 5.0,
          "maximum": 265.0,
          "description": "Breach vertical incision depth in metres (hb)"
        },
        "side_slope_h_v": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 1.0,
          "description": "Trapezoidal breach side slope (z: horizontal:1 vertical)"
        },
        "empirical_formula": {
          "type": "string",
          "enum": ["Froehlich-2008", "MacDonald-Langridge-Monopolis-1984", "Von-Thun-Gillette-1990"],
          "default": "Froehlich-2008"
        }
      }
    },
    "initial_conditions": {
      "type": "object",
      "required": [
        "reservoir_level_m",
        "released_volume_mcm"
      ],
      "properties": {
        "reservoir_level_m": {
          "type": "number",
          "minimum": 600.0,
          "maximum": 845.0,
          "description": "Water surface elevation at failure inception in metres MSL"
        },
        "released_volume_mcm": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 4000.0,
          "description": "Total active storage volume released in Million Cubic Metres"
        },
        "tailwater_elevation_m": {
          "type": "number",
          "description": "Downstream starting water surface elevation in metres MSL"
        }
      }
    },
    "roughness": {
      "type": "object",
      "properties": {
        "channel_manning_n": {
          "type": "number",
          "minimum": 0.025,
          "maximum": 0.08,
          "default": 0.035
        },
        "floodplain_manning_n": {
          "type": "number",
          "minimum": 0.04,
          "maximum": 0.15,
          "default": 0.065
        }
      }
    },
    "boundary_conditions": {
      "type": "object",
      "properties": {
        "simulation_horizon_hr": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 72.0,
          "default": 18.0
        },
        "downstream_boundary": {
          "type": "string",
          "enum": ["normal_depth", "free_outflow", "rating_curve"],
          "default": "normal_depth"
        }
      }
    },
    "solver_selection": {
      "type": "string",
      "enum": ["delft3d-fm", "dualsphysics"],
      "default": "delft3d-fm"
    }
  }
}
